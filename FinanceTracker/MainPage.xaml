<Page
    x:Class="FinanceTracker.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FinanceTracker"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <TextBlock Text="Personal Finance Tracker" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- 2. SUMMARY CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Balance Card -->
            <Border Grid.Column="0" Background="#2C3E50" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Total Balance" Foreground="#BDC3C7" FontSize="14"/>
                    <TextBlock x:Name="TxtTotalBalance" Text="0.00 €" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Income Card -->
            <Border Grid.Column="1" Background="#27AE60" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="Total Income" Foreground="#E8F8F5" FontSize="14"/>
                    <TextBlock x:Name="TxtTotalIncome" Text="0.00 €" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Expense Card -->
            <Border Grid.Column="2" Background="#C0392B" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Total Expenses" Foreground="#FDEDEC" FontSize="14"/>
                    <TextBlock x:Name="TxtTotalExpense" Text="0.00 €" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. MAIN CONTENT: FORM + LIST -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ADD TRANSACTION FORM -->
            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                <TextBlock Text="New Transaction" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <TextBox x:Name="TxtTitle" Header="Description / Title" PlaceholderText="e.g., Salary, Groceries" Margin="0,0,0,12"/>

                <TextBox x:Name="TxtAmount" Header="Amount (€)" PlaceholderText="0.00" InputScope="Number" Margin="0,0,0,12"/>

                <ComboBox x:Name="CmbType" Header="Type" HorizontalAlignment="Stretch" Margin="0,0,0,12" SelectedIndex="0">
                    <ComboBoxItem Content="Income"/>
                    <ComboBoxItem Content="Expense"/>
                </ComboBox>

                <ComboBox x:Name="CmbCategory" Header="Category" HorizontalAlignment="Stretch" Margin="0,0,0,20" SelectedIndex="0">
                    <ComboBoxItem Content="Food"/>
                    <ComboBoxItem Content="Bills / Rent"/>
                    <ComboBoxItem Content="Salary"/>
                    <ComboBoxItem Content="Entertainment"/>
                    <ComboBoxItem Content="Transport"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <Button Content="Add Transaction" 
                        Click="BtnAddTransaction_Click" 
                        Style="{StaticResource AccentButtonStyle}" 
                        HorizontalAlignment="Stretch" 
                        Height="40"/>
            </StackPanel>

            <!-- TRANSACTIONS LIST -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Transaction History" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <ListView x:Name="LstTransactions" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:Transaction">
                            <Grid Padding="8,12" BorderThickness="0,0,0,1" BorderBrush="#E0E0E0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="16"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind Category}" Foreground="Gray" FontSize="12"/>
                                        <TextBlock Text=" • " Foreground="Gray" FontSize="12"/>
                                        <TextBlock Text="{x:Bind DateFormatted}" Foreground="Gray" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="1" 
                                           Text="{x:Bind AmountFormatted}" 
                                           Foreground="{x:Bind ColorHex}" 
                                           FontWeight="Bold" 
                                           FontSize="16" 
                                           VerticalAlignment="Center" 
                                           Margin="16,0"/>

                                <Button Grid.Column="2" 
                                        Content="✕" 
                                        Click="BtnDelete_Click" 
                                        Tag="{x:Bind}" 
                                        Background="Transparent" 
                                        Foreground="Red" 
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>